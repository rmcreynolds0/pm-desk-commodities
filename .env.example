# Copy to .env and fill in. .env is gitignored - never commit real keys.

# ---------------------------------------------------------------------------
# IBKR PAPER LOGINS - ONE PER AGENT
# ---------------------------------------------------------------------------
# Each agent trades its OWN paper account through its own gateway container.
# IBKR caps a paper account at $1,000,000; four agents sharing one account
# would drop gold, heating oil, feeder cattle and copper to zero contracts -
# four of the five markets whose removal was tested and rejected. One account
# each removes that constraint. See config/xsec.yaml ibkr.account_mode.
#
# These MUST be paper-only logins: a headless gateway cannot answer a phone
# 2FA prompt. Four separate IBKR usernames are required.
TWS_USERID_0=paper_username_for_agent_0
TWS_PASSWORD_0=paper_password_for_agent_0
TWS_USERID_1=paper_username_for_agent_1
TWS_PASSWORD_1=paper_password_for_agent_1
TWS_USERID_2=paper_username_for_agent_2
TWS_PASSWORD_2=paper_password_for_agent_2
TWS_USERID_3=paper_username_for_agent_3
TWS_PASSWORD_3=paper_password_for_agent_3

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# docker-compose sets the per-agent endpoints itself, so these are only needed
# when running the engine outside Docker against gateways on your own machine.
# IBKR_HOST_AGENT_0=127.0.0.1
# IBKR_PORT_AGENT_0=4002
# IBKR_PORT_AGENT_1=4012
# IBKR_PORT_AGENT_2=4022
# IBKR_PORT_AGENT_3=4032

# ---------------------------------------------------------------------------
# FLEX WEB SERVICE - external, READ-ONLY tracking
# ---------------------------------------------------------------------------
# Lets someone follow the book WITHOUT the trading login. A Flex token can
# only read reports; it cannot place orders or reset the account. This is the
# credential you share with a teammate or an external tracker.
#
# It is also how the stack checks ITSELF: data/live/xsec_books.db is written
# by the same code that places the orders, so Flex is the only independent
# account of what actually filled. scripts/flex_pull.py reconciles the two.
#
# To generate (IBKR Client Portal):
#   1. Settings -> Account Settings -> Reporting -> Flex Web Service
#      -> generate a token. Note the expiry - lapsed tokens fail quietly.
#   2. Performance & Reports -> Flex Queries -> new ACTIVITY Flex Query.
#      Include: Open Positions, Trades, Net Asset Value.
#      Date period: Last 30 Days. Save, then note the Query ID.
FLEX_TOKEN=
FLEX_QUERY_ID=

# ---------------------------------------------------------------------------
# RESEARCH DATA (optional - the LIVE stack needs none of these)
# ---------------------------------------------------------------------------
# The cross-sectional strategy takes its signals from IBKR itself. These keys
# are only for backtest/research work against the historical mirror.
# EIA_API_KEY=your_free_key_from_https://www.eia.gov/opendata/
# NOAA_TOKEN=optional_token_from_https://www.ncdc.noaa.gov/cdo-web/token
# FRED_API_KEY=optional_free_key_from_https://fred.stlouisfed.org/docs/api/
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=quantt-historical-market-data
