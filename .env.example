# Copy to .env and fill in. .env is gitignored — never commit real keys.
EIA_API_KEY=your_free_key_from_https://www.eia.gov/opendata/
NOAA_TOKEN=optional_token_from_https://www.ncdc.noaa.gov/cdo-web/token
FRED_API_KEY=optional_free_key_from_https://fred.stlouisfed.org/docs/api/api_key.html

# IBKR paper gateway (defaults shown; change if your gateway differs)
# On the docker-compose VM set IBKR_HOST=ib-gateway (the container name).
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=11

# --- docker-compose only (the headless IB Gateway container login) ---------
# Your IBKR PAPER account credentials. Used by the ib-gateway container to
# auto-login; never used by the python code directly.
TWS_USERID=your_ibkr_paper_username
TWS_PASSWORD=your_ibkr_paper_password
